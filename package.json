{
  "name": "ct-vscode",
  "displayName": "Ct — C with Traits",
  "description": "Syntax highlighting, snippets, go-to-definition and language configuration for Ct (C with Traits), the trait-flavoured C compiled by ct (ctc is the compatibility alias).",
  "version": "0.2.0",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ct"
  ],
  "publisher": "samxxu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ct",
    "c",
    "traits",
    "vtable",
    "ctc",
    "ct-lang",
    "c with traits",
    "generics",
    "closures",
    "loop"
  ],
  "galleryBanner": {
    "color": "#16222e",
    "theme": "dark"
  },
  "homepage": "https://github.com/samxxu/ct-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/samxxu/ct-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/samxxu/ct-vscode/issues"
  },
  "scripts": {
    "test": "node test/check-index.js && python3 test/check-grammar.py && python3 test/check-surface.py",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^4"
  },
  "contributes": {
    "languages": [
      {
        "id": "ct",
        "aliases": [
          "Ct",
          "CT",
          "ct",
          "C with Traits"
        ],
        "extensions": [
          ".ct"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ct",
        "scopeName": "source.ct",
        "path": "./syntaxes/ct.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ct",
        "path": "./snippets/ct.json"
      }
    ]
  }
}
